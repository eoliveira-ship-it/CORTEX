  query1 := 'select count(*) from param_multidim_generique where CODE_type_utilisation='''||code_type||''' ';
  query4 := 'where p1.id_engagement in (select p2.id_engagement
             from '|| TABLE_DEST ||' p2, btr_surete_pers sur, BTR_TIERS btr, BTR_OPERATION o, BTR_SURETE_REELLE R, rs_famille_actif F
