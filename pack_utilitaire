-- nom : fonction  F_GET_CODE_NUTS                                         --
-- but : trancoder les couples codes postal/code pays en code NUTS         --
-- auteur : J-M PERQUE CDS ATOS  01/03/2018                                --
-- Specifications : Voir  US44 du  projet ANACREDIT Sprint 5 dans Taiga    --
-- entrees : code  postal sur  5 caract?res                                --
--           code pays sur  2 caract?res                                   --
-- retour : Code NUTS sur 5 caracters                                      --
-----------------------------------------------------------------------------
    FUNCTION F_GET_CODE_NUTS (CD_POSTAL IN VARCHAR2, CD_PAYS IN VARCHAR2)  RETURN VARCHAR2

	IS
	V_CODE_NUTS varchar2(10); -- Code NUTS a renvoyer
	V_CODE_DEP varchar2(3); -- Code du departement
	V_NB_NUTS NUMBER; -- Nombre dde code NUTS du code postal en table
	BEGIN


	-- Si le code pays est 'FR'
	IF ( CD_PAYS ='FR')  THEN

	--Si le code postal est sup?rieur ? 97000 prendre pour code d?partement les 3 premiers caract?res du code postal (DOM-TOM),
		IF (CD_POSTAL >= '97000') THEN
			V_CODE_DEP := substr(CD_POSTAL, 1,3);

	--Sinon prendre pour code d?partement '0' concat?n? aux 2 premiers caract?res du code postal (M?tropole et  Corse)
		ELSE
			V_CODE_DEP := '0'|| substr(CD_POSTAL, 1,2);
		END IF;
	--compter le nombre de code NUTS (CD_NUTS) de  pour  ce code d?partement (CD_DEPT_INSEE) dans la table RS_CORRES_DEPT_NUTS.

		select count(1)
			into V_NB_NUTS
			from RS_CORRES_DEPT_NUTS
			where  CD_DEPT_INSEE = V_CODE_DEP;
	--S'il y  en a un pr?cis?ment le  retourner comme code NUTS
		IF (V_NB_NUTS = 1)
		THEN
			select CD_NUTS
				into V_CODE_NUTS
				from RS_CORRES_DEPT_NUTS
				where  CD_DEPT_INSEE = V_CODE_DEP;
	--Sinon retourner comme code NUTS le code pays compl?t? avec 'ZZZ'
		ELSE
			V_CODE_NUTS := CD_PAYS||'ZZZ';
		END  IF;
	-- Sinon
	ELSE

    -- IF (CD_PAYS IS NOT NULL)
	-- Si c'est  un pays de  l'Union Europ?enne
	IF (CD_PAYS IN ('BE', 'BG', 'CZ', 'DK',
	'DE', 'EE', 'IE', 'EL', 'ES', 'HR', 'IT', 'CY', 'LV',
	'LT', 'LU', 'HU', 'MT', 'NL', 'AT', 'PL', 'PT', 'RO',
	'SI', 'SK', 'FI', 'SE', 'UK') )
    THEN
    -- Retourner comme code NUTS le code  pays compl?t? avec 'ZZZ'
      V_CODE_NUTS := CD_PAYS||'ZZZ';
    -- Fin si le code pays est 'FR'
    ELSE
      V_CODE_NUTS := NULL;
    END IF;
	END IF;

	RETURN V_CODE_NUTS;

	END  F_GET_CODE_NUTS;

-----------------------------------------------------------------------------
-- nom : fonction  F_CODE_EFFECTIF_NB_SALARIE                                        --
-- but : trancoder le code effectif en la valeur basse des effectifs de ce code         --
-- auteur : J-M PERQUE CDS ATOS  28/05/2018                                --
-- Specifications : Voir  US346 du  projet ANACREDIT     --
-- entrees : EFFECTIF : Code Effectif en NUMBER
-- retour : Nombre de salari?s pour la tranche basse                                     --
-----------------------------------------------------------------------------
    FUNCTION F_CODE_EFFECTIF_NB_SALARIE (EFFECTIF IN NUMBER)  RETURN NUMBER

	IS

	V_RET NUMBER; -- Nombre de salari?s renvoy? pour la tranche EFFECTIF
	BEGIN

    select DECODE (NVL(EFFECTIF, -999)
	 ,-999, NULL -- Null -> Null
	,0, 0 -- 0	0 salari?
	,1, 1 -- 1	1 ou 2 salari?s
	,2, 3 -- 2	3 ? 5 salari?s
	,3, 6 -- 3	6 ? 9 salari?s
	, 11, 10  -- 11	10 ? 19 salari?s
	, 12, 20  -- 12	20 ? 49 salari?s
	, 21, 50  -- 21	50 ? 99 salari?s
	, 22, 100  -- 22	100 ? 199 salari?s
	, 31, 200  -- 31	200 ? 249 salari?s
	, 32, 250   -- 32	250 ? 499 salari?s
	, 41, 500  -- 41	500 ? 999 salari?s
	, 42, 1000 -- 42	1000 ? 1999 salari?s
	, 51, 2000  -- 51	2000 ? 4999 salari?s
	, 52, 5000  -- 52	5000 ? 9999 salari?s
	, 53, 10000 -- 53	10 000 salari?s et plus
	)
	INTO V_RET
	FROM Dual;

	RETURN V_RET;

	END  F_CODE_EFFECTIF_NB_SALARIE;

