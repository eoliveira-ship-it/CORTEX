--------------------------------------------------------------------------
PROCEDURE DB_TRAITE_ERREUR (P_ORA_MSG   IN VARCHAR2,
                            P_CONTEXTE  IN VARCHAR2,
                            P_CODE      IN NUMBER) IS
BEGIN

dbms_output.put_line(substr('ERR-'||P_CODE||' : '||P_CONTEXTE,100));

IF P_ORA_MSG != 'O' THEN
  rollback;
  raise_application_error(-20001,P_ORA_MSG);
END IF;

END;

