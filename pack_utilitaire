-- nom : fonction  F_DATE_ARRETE_TRIMESTRE_PREC                                        		--
-- but : calculer de la date d'arr?t? du trimestre pr?c?dant la date en argument       		--
-- auteur : J-M PERQUE CDS ATOS  10/07/2018 			                               		--
-- Specifications : Voir  US418 du  projet ANACREDIT  						   		   		--
-- entrees : DT : Date dont la date d'arr?t? du trimestre pr?c?dent doit ?tre calcul?e DATE --
-- retour : Date d'arr?t? du trimestre pr?c?dent                                      		--
----------------------------------------------------------------------------------------------
	FUNCTION F_DATE_ARRETE_TRIMESTRE_PREC(DT DATE) RETURN DATE
    IS
	V_RET DATE; -- Nombre de salari?s renvoy? pour la tranche EFFECTIF
	ANNEE NUMBER; -- Ann?e  de DT
	MOIS NUMBER; -- Mois de DT
	BEGIN
	IF  (DT  IS NULL) THEN
		V_RET := NULL;
	ELSE
		SELECT EXTRACT (month FROM DT) INTO MOIS FROM DUAL;
		SELECT EXTRACT (year FROM DT) INTO ANNEE FROM DUAL;
		SELECT CASE  WHEN MOIS IN (1, 2, 3) THEN TO_DATE('31-12-'|| TO_CHAR(ANNEE -1),'DD-MM-YYYY')
				WHEN MOIS IN (4, 5, 6) THEN TO_DATE('31-03-'|| TO_CHAR(ANNEE),'DD-MM-YYYY')
				WHEN MOIS IN (7, 8, 9) THEN TO_DATE('30-06-'|| TO_CHAR(ANNEE),'DD-MM-YYYY')
				WHEN MOIS IN (10, 11, 12) THEN TO_DATE('30-09-'|| TO_CHAR(ANNEE),'DD-MM-YYYY')
				END
        INTO V_RET
		FROM DUAL;
	END IF;
	RETURN V_RET;

	END F_DATE_ARRETE_TRIMESTRE_PREC;

