             And o.ID_TIERS = btr.ID_TIERS
             AND p2.id_engagement = R.id_operation(+)
             AND R.CD_FAMILLE_ACTIF = F.CD_FAMILLE_ACT(+) ';



  v_where2 := ' ';
  v_where3 := ' ';
    for I in 1 .. 8 LOOP
      execute immediate QUERY1 into V_COUNT;
        query3 := query2;
