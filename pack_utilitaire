            IF (v_count = 0) THEN
                query1 := REPLACE(query1, v_where1, '');
                v_where2:= REPLACE(v_where2, v_where1, '');
                query4 := REPLACE(query4, v_where3, '');
            END IF;

           IF (i = 1) THEN
             IF ( VAL <> Val_param(1)) THEN
                VAL := Val_param(1);
                VAL2 := VAL2 || ', ' ||Val_param(1);
             END IF;
            END IF;

            IF (TABLE_DEST = 'eng_corp_p1') THEN
               V_code_SGMT :='CORP';
            ELSIF (TABLE_DEST = 'eng_corp_p2') THEN
               V_code_SGMT :='CORP';
            ELSE
                V_code_SGMT :='RETA';
            END IF;


      --      IF (i = 4 OR i = 7) THEN
            v_where1 := ' AND CODE_PARAM_'||i||' = '''||Code_param(i)||'''
                         '||(CASE WHEN (Val_param(i) IS NULL) THEN ' AND VAL_PARAM_'||i||' is NULL'
