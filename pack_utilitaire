--------------------------------------------------------------------------
-- nom : fonction  F_FORMAT_MONTANT                                     --
-- but : formater un montant au format attendu dans le CRRV3            --
-- auteur : P. Bizot, le 05/09/2008                                     --
-- entree : montant entier en format num?rique                          --
-- retour : montant au format carat?re format? de la maniere suivante:  --
--          '+0000000000123456  '  si montant > 0                       --
--          '-0000000000123456  '  si montant < 0                       --
--          '                   '  si montant null ou ?gal ? 0          --
--------------------------------------------------------------------------
FUNCTION F_FORMAT_MONTANT (MNT  NUMBER)  RETURN VARCHAR2
IS

  v_MNT_FORMATE   VARCHAR2(19);

BEGIN

    select  case when mnt > 0 then '+'||LPAD(NVL(to_char(abs(mnt)), ' '), 16, 0)||'  '
            when mnt < 0 then '-'||LPAD(NVL(to_char(abs(mnt)), ' '), 16, 0)||'  '
            when mnt is null then LPAD(' ', 19, ' ')
            when mnt = 0 then LPAD(' ', 19, ' ')
            end into v_MNT_FORMATE
    from dual;

  RETURN v_MNT_FORMATE;

END F_FORMAT_MONTANT;

--------------------------------------------------------------------------
-- nom : fonction  FONC_VERIFIER_SIRET                                  --
-- but : Verifier la vraisemblance d'un siret passe en parametre        --
-- auteur : L. Blanchard                                                --
-- entree : siret ? verifier                                            --
-- retour : O si siret semble correct, N sinon                          --
--------------------------------------------------------------------------
FUNCTION FONC_VERIFIER_SIRET ( SIRET VARCHAR2 )
   RETURN VARCHAR2
IS

  VAR_SIRET   VARCHAR2(14);
  POS         INTEGER;
  VAL         INTEGER;
  TOTAL       INTEGER := 0;

  VRAISEMBLANCE VARCHAR2(1) := 'N';

BEGIN

    -- UNIQUEMENT 9 CHIFFRES SINON ERREUR -> EXCEPTION
    VAL := TO_NUMBER (SUBSTR(SIRET, 1, 9));

    FOR POS IN 1 .. 9
    LOOP

      VAL := SUBSTR(SIRET, POS, 1);

      IF  MOD (POS, 2) = 0
      THEN
        VAL := VAL * 2 ;
        IF VAL > 9
        THEN
          VAL := VAL - 9;
        END IF;
      END IF;

      TOTAL := TOTAL + VAL;

    END LOOP;

    IF TOTAL > 0 AND MOD(TOTAL, 10) = 0
    THEN
      VRAISEMBLANCE := 'O';
    END IF;

  RETURN VRAISEMBLANCE;

  EXCEPTION
    WHEN OTHERS THEN
      RETURN 'N';

END FONC_VERIFIER_SIRET;

