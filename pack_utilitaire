-- nom : fonction  F_FORMAT_MONTANT_13_2                                   --
-- but : formater un montant au format attendu dans le CRR                 --
-- auteur : H. GOMES                                                       --
-- entree : montant entier en format numerique                             --
-- retour : montant au format caraere formate de la maniere suivante:      --
-- 13 dont signe et 2 décimales
--    valeur 1    '+000000000100'  si montant > 0                          --
--    valeur -1   '-000000000100'  si montant < 0                          --
--    valeur null '+000000000000'  si montant null                         --
--    valeur 0    '+000000000000'  si montant egal a 0                     --
-----------------------------------------------------------------------------
FUNCTION F_FORMAT_MONTANT_13_2 (MNT_13_2  NUMBER)  RETURN VARCHAR2
IS

  v_MNT_13_2_FORMATE   VARCHAR2(13);

BEGIN

	    select  case when MNT_13_2 > 0 then '+'||LPAD(NVL(to_char(abs(trunc(MNT_13_2))), 0), 10, 0)||RPAD(NVL(substr(To_char(MNT_13_2 - TRUNC(MNT_13_2) ),2),0),2,0)
            when MNT_13_2 < 0 then '-'||LPAD(NVL(to_char(abs(trunc(MNT_13_2))), 0), 10, 0)||RPAD(NVL(substr(To_char(abs(MNT_13_2) - TRUNC(abs(MNT_13_2)) ),2),0),2,0)
            when MNT_13_2 is null then '+'||LPAD(0, 10, 0)||'00'
            when MNT_13_2 = 0 then '+'||LPAD(0, 10, 0)||'00'
            end into v_MNT_13_2_FORMATE
    from dual;

  RETURN v_MNT_13_2_FORMATE;

END F_FORMAT_MONTANT_13_2;

-----------------------------------------------------------------------------
-- nom : fonction F_FORMAT_MONTANT_NEGATIF_19                             --
-- but : envoyer uniquement des valeurs positives, 0 pour les autres cas   --
-- auteur : H. GOMES                                                       --
-- entree : montant entier en format numerique                             --
-- retour : montant au format caratere formate de la maniere suivante:     --
--          '+0000000000123456  '  si montant > 0                          --
--          '+0000000000000000  '  si montant < 0, null ou egal a 0        --
-----------------------------------------------------------------------------
FUNCTION F_FORMAT_MONTANT_NEGATIF_19  (MNT_BIS2  NUMBER)  RETURN VARCHAR2
IS

  v_MNT_BIS2_FORMATE   VARCHAR2(19);

BEGIN

	    select  case when mnt_bis2 > 0 then '+'||LPAD(NVL(to_char(abs(trunc(mnt_bis2))), 0), 16, 0)||RPAD(NVL(substr(To_char(mnt_bis2 - TRUNC(mnt_bis2) ),2),0),2,0)
            when mnt_bis2 < 0     then '+'||LPAD(0, 16, 0)||'00'
            when mnt_bis2 is null then '+'||LPAD(0, 16, 0)||'00'
            when mnt_bis2 = 0     then '+'||LPAD(0, 16, 0)||'00'
            end into v_MNT_BIS2_FORMATE
    from dual;

  RETURN v_MNT_BIS2_FORMATE;

END F_FORMAT_MONTANT_NEGATIF_19 ;

-----------------------------------------------------------------------------
-- nom : fonction  F_FORMAT_MONTANT_DYNAMIC                                        --
-- but : formater un montant au format attendu dans le CRR                 --
-- auteur : P. MESQUITA                                                       --
-- entree :                                                                --
--   - MNT  : montant entier en format numerique                           --
--   - N_CAR: taille totalle                                               --
--   - N_DEC: nombre de chiffres decimales                                 --
--   - SIGNE: flag pour afficher (1) ou pas (0) le signal (+/-):           --
--            avec signal par défaut                                       --
--   - SEPARATEUR: separateur decimale:                                    --
--                 sans separateur par défaut                              --
-- retour : montant au format caraere formate de la maniere suivante:      --
-- N_CAR = 13 dont signe = 1 et N_DEC = 2 décimales pour MNT = 1           --
--    valeur 1    '+000000000100'  si montant > 0                          --
--    valeur -1   '-000000000100'  si montant < 0                          --
--    valeur null '+000000000000'  si montant null                         --
--    valeur 0    '+000000000000'  si montant egal a 0                     --
-----------------------------------------------------------------------------
FUNCTION F_FORMAT_MONTANT_DYNAMIC (MNT  NUMBER, N_CAR NUMBER, N_DEC NUMBER:=0, SIGNE CHAR:='1', SEPARATEUR VARCHAR2:='' ) RETURN VARCHAR2
IS

  v_MNT    VARCHAR2(32767);
  v_LENGTH NUMBER;

BEGIN
      v_LENGTH := N_CAR - CASE WHEN SIGNE='1' THEN 1 ELSE 0 END - NVL(LENGTH(SEPARATEUR), 0);

	    select
        case when MNT > 0          then case when SIGNE='1' then '+' else '' end || LPAD(NVL(to_char(abs(trunc(MNT))), 0), v_LENGTH - n_dec, 0)||SEPARATEUR||RPAD(NVL(substr(To_char(MNT - TRUNC(MNT) ),case when mnt <0 then 3 else 2 end),0),n_dec,0)
             when MNT < 0          then case when SIGNE='1' then '-' else '' end || LPAD(NVL(to_char(abs(trunc(MNT))), 0), v_LENGTH - n_dec, 0)||SEPARATEUR||RPAD(NVL(substr(To_char(MNT - TRUNC(MNT) ),case when mnt <0 then 3 else 2 end),0),n_dec,0)
             when NVL(MNT, 0 ) = 0 then case when SIGNE='1' then '+' else '' end || LPAD(0, v_LENGTH-n_dec, 0)||SEPARATEUR||RPAD(0,n_dec,0)
            end into v_MNT
    from dual;

  RETURN v_MNT;

END F_FORMAT_MONTANT_DYNAMIC;


