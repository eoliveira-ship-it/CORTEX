=LET(
ref,TRIM($E4),
fmt,UPPER(TRIM($T4)),
lng,$W4,
rule,$U4,
colName,"P1_"&SUBSTITUTE(SUBSTITUTE(ref,".","_")," ","_"),
cutTxt,IFERROR(LEFT(rule,SEARCH("cimale",rule)-1),""),
cutTxt2,IFERROR(TRIM(LEFT(TRIM(cutTxt),LEN(TRIM(cutTxt))-2)),""),
nbDec,IFERROR(VALUE(TRIM(RIGHT(SUBSTITUTE(cutTxt2," ",REPT(" ",50)),50))),0),
sgn,IF(ISNUMBER(SEARCH("signe",rule)),1,0),
sep,IF(ISNUMBER(SEARCH("parateur",rule)),1,0),
colType,
IF(fmt="DATE",
"DATE",
IF(fmt="ALPHA",
"VARCHAR2("&lng&")",
IF(fmt="NUM",
"NUMBER("&(lng-sgn-sep)&IF(nbDec>0,","&nbDec,"")&")",
"VARCHAR2("&lng&")"
)
)
),
IF(
LEFT(ref,3)<>"P1 ",
"",
"    "&colName&"  "&colType&" ,  -- "&ref&" "&$F4
)
)
